{
  "name": "open-pocket-studio",
  "productName": "Open Pocket Studio",
  "version": "1.2.0",
  "description": "Install firmware and bitstream, prepare SD updates and remote-control Open Pocket GBC",
  "main": "main.js",
  "author": "LakoMoor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "io.github.lakomoor.openpocket.studio",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "sim/**",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "artifactName": "OpenPocketStudio-${version}.exe",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "OpenPocketStudio-${version}-mac-${arch}.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "artifactName": "OpenPocketStudio-${version}-linux-${arch}.${ext}",
      "maintainer": "LakoMoor <LakoMoor@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libudev1"
      ]
    }
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "homepage": "https://github.com/LakoMoor/open-pocket-gbc"
}
